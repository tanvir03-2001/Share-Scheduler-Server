# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/facebook-auto-post

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:3000
# For local development, also supports: http://127.0.0.1:3000
# For production (Vercel), use your actual frontend domain:
# CLIENT_URL=https://client-two-iota-21.vercel.app

# Facebook Business App Configuration
FACEBOOK_APP_ID=your-facebook-business-app-id-here
FACEBOOK_APP_SECRET=your-facebook-business-app-secret-here
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/facebook/callback
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback
# For production (Vercel), update these to your server domain:
# FACEBOOK_REDIRECT_URI=https://your-server-domain.vercel.app/api/facebook/callback
# FACEBOOK_CALLBACK_URL=https://your-server-domain.vercel.app/api/auth/facebook/callback

# Facebook Business API Configuration
FACEBOOK_BUSINESS_API_VERSION=v18.0
FACEBOOK_BUSINESS_SCOPES=public_profile,email,pages_manage_posts,pages_read_engagement,pages_show_list,pages_manage_metadata,pages_read_user_content

# Session Configuration (for Passport.js)
SESSION_SECRET=your-session-secret-key-here-change-this-in-production

# Email Configuration (Optional - for email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Cloudinary Configuration (for media uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret